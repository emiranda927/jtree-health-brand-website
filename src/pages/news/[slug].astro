---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import {
  eventJsonLd,
  formatLongDate,
  formatShortDate,
  formatTime,
  isPast,
  upcomingSessions,
} from '../../lib/news';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const e = d.event;
const pageUrl = new URL(`/news/${entry.id}/`, Astro.site ?? 'https://www.jtreehealth.com').href;

const past = isPast(entry);
const upcoming = upcomingSessions(entry);
const nextSession = upcoming[0];

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'News & events', item: new URL('/news/', Astro.site ?? 'https://www.jtreehealth.com').href },
    { '@type': 'ListItem', position: 2, name: d.title, item: pageUrl },
  ],
};

// Past series keep the page (the details stay useful and the URL keeps its
// signals) but drop the Event markup, which is only meaningful while it's open.
const jsonLd = past ? [breadcrumb] : [...eventJsonLd(entry, pageUrl), breadcrumb];
---
<Base
  bodyClass="brand-page rollout-page"
  title={d.seo.title}
  description={d.seo.description}
  jsonLd={jsonLd}
>
  <PageHero
    eyebrow={d.hero.eyebrow}
    art="approach"
    title={d.title}
    sub={d.hero.sub}
    primaryCta={e && !past ? { label: e.registrationLabel, href: e.registrationUrl, external: true } : undefined}
    secondaryCta={!past ? { label: 'Call (919) 335-5053', href: 'tel:+19193355053' } : undefined}
  />

  {past && (
    <!-- ===== STATUS ===== -->
    <section class="section" aria-label="Status">
      <div class="container-x">
        <p class="workshop-ended" data-reveal>
          This series finished on {formatLongDate(d.endDate)} and is no longer open for signup.
          To hear about the next one, <a href="/contact">get in touch</a>.
        </p>
      </div>
    </section>
  )}

  {e && (
    <!-- ===== AT A GLANCE ===== -->
    <section class="section workshop-glance" aria-label="Workshop details">
      <div class="container-x">
        <dl class="workshop-facts" data-reveal-group>
          {e.details.map((fact) => (
            <div class="workshop-facts__item" data-reveal-item>
              <dt>{fact.title}</dt>
              <dd>{fact.body}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  {e && (
    <!-- ===== SCHEDULE (Field) ===== -->
    <section class="section surface-lavender" aria-labelledby="workshop-schedule-title">
      <div class="container-x">
        <div class="section-head" data-reveal>
          <p class="eyebrow">12 weekly topics</p>
          <h2 class="section-title font-display" id="workshop-schedule-title">Weekly schedule</h2>
          <p class="section-sub">
            Every Tuesday, {formatTime(e.startTime)} to {formatTime(e.endTime)}. Come to one or all twelve.
          </p>
        </div>
        <ol class="schedule" data-reveal>
          {e.sessions.map((session) => {
            const done = session.date < (nextSession?.date ?? '9999-12-31');
            return (
              <li class:list={['schedule__row', done && 'is-done']}>
                <span class="schedule__date">{formatShortDate(session.date)}</span>
                <span class="schedule__topic">
                  {session.href ? (
                    <a href={session.href}>{session.topic}</a>
                  ) : session.topic}
                </span>
                {done && <span class="schedule__flag">Passed</span>}
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section class="section surface-cream-deep" aria-labelledby="workshop-about-title">
      <div class="container-x">
        <div class="prose" data-reveal>
          <h2 class="section-title font-display" id="workshop-about-title">About the workshop</h2>
          {d.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  {e && !past && (
    <!-- ===== SIGN UP ===== -->
    <section class="section" aria-labelledby="workshop-signup-title">
      <div class="container-x">
        <div class="prose" data-reveal>
          <h2 class="section-title font-display" id="workshop-signup-title">How to sign up</h2>
          {nextSession && (
            <p class="lead">
              Next up: <strong>{nextSession.topic}</strong> on {formatLongDate(nextSession.date)}.
            </p>
          )}
          <p>
            Fill out the form to reserve your spot, or call or email us directly.
          </p>
          <p>
            Prefer to talk to a person? Call <a href="tel:+19193355053">(919) 335-5053</a> or
            email <a href="mailto:admissions@jtreehealth.com">admissions@jtreehealth.com</a>.
          </p>
        </div>
        <!-- Outside .prose deliberately: `.prose a` (class+element) outranks
             `.btn` (single class) and silently overrides button text/border
             color otherwise — see global.css. -->
        <div class="page-hero__actions" data-reveal>
          <a class="btn" href={e.registrationUrl} target="_blank" rel="noopener noreferrer">
            {e.registrationLabel} <span class="btn__arrow">→</span>
          </a>
          <a class="btn btn--ghost" href="/contact">Ask a question</a>
        </div>
        <p class="workshop-address" data-reveal>
          {e.locationName}<br />
          {e.streetAddress}<br />
          {e.addressLocality}, {e.addressRegion} {e.postalCode}
        </p>
      </div>
    </section>
  )}

  <!-- ===== CLOSING CTA ===== -->
  <section class="section surface-green" aria-labelledby="workshop-cta-title">
    <div class="container-x">
      <div class="section-head section-head--center" data-reveal>
        <h2 class="section-title font-display" id="workshop-cta-title">{d.closing.title}</h2>
        <p class="section-sub">{d.closing.body}</p>
        <div class="page-hero__actions">
          <a class="btn btn--on-dark" href="/get-started">{d.closing.primaryCta} <span class="btn__arrow">→</span></a>
          <a class="btn btn--ghost-on-dark" href="tel:+19193355053">Call (919) 335-5053</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .workshop-ended {
    max-width: 48rem;
    margin-bottom: 2.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-cream-deep);
    color: var(--color-ink-soft);
    font-size: var(--type-reading);
    line-height: 1.6;
  }

  /* Sits directly under the hero, so it carries its own (tighter) rhythm
     rather than the full --section-y used elsewhere on the page. */
  .workshop-glance { padding-block: clamp(1.25rem, 2vw, 2rem) clamp(2.5rem, 4vw, 3.5rem); }

  .workshop-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1.75rem 2.5rem;
  }
  .workshop-facts dt {
    font-family: var(--font-head);
    font-size: 0.82rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-deep-green);
    margin-bottom: 0.45rem;
  }
  .workshop-facts dd {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--type-reading);
    line-height: 1.62;
  }

  .schedule {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 46rem;
    border-top: 1px solid rgba(30, 61, 52, 0.22);
    counter-reset: session;
  }
  .schedule__row {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding: 0.95rem 0;
    border-bottom: 1px solid rgba(30, 61, 52, 0.22);
  }
  .schedule__date {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.92rem;
    color: var(--color-deep-green);
    white-space: nowrap;
  }
  .schedule__topic {
    font-size: var(--type-reading);
    line-height: 1.45;
    color: var(--color-deep-green);
  }
  .schedule__topic a { color: inherit; text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .schedule__topic a:hover { text-decoration-thickness: 2px; }
  .schedule__flag {
    font-family: var(--font-head);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: rgba(30, 61, 52, 0.55);
  }
  .schedule__row.is-done .schedule__date,
  .schedule__row.is-done .schedule__topic { opacity: 0.5; }

  @media (max-width: 30rem) {
    .schedule__row { grid-template-columns: 4rem 1fr; }
    .schedule__flag { grid-column: 2; }
  }

  .workshop-address {
    margin-top: 2.5rem;
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
</style>
